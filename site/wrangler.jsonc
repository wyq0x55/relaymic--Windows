{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relaymic-site",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-17",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "routes": [
    { "pattern": "relaymic.com", "custom_domain": true },
    { "pattern": "www.relaymic.com", "custom_domain": true }
  ],

  // 通知邮件。destination_address 把收件人锁死在这一个地址上 ——
  // 这层限制在平台侧，代码写错也发不到别处去。
  "send_email": [
    {
      "name": "NOTIFY",
      "destination_address": "chshu4@gmail.com"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relaymic",
      "database_id": "5739a3e1-1d31-49fd-a66c-b8e6486d13f4"
    }
  ],

  "observability": {
    "enabled": true
  }
}
