{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relaymic-site",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-17",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "routes": [
    { "pattern": "relaymic.com", "custom_domain": true },
    { "pattern": "www.relaymic.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
